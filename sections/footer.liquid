<footer class="dark band">
  <div class="wrap">
    <div class="flogo">
      <span class="mk mk-lines" aria-hidden="true"></span>
      <img class="wm" src="{{ 'wordmark-plain-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="640" height="150" loading="lazy">
    </div>
    <div class="tagline">{{ section.settings.tagline | escape }}</div>
    <div class="links">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endfor -%}
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
    </div>
    <div class="copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Dogs / Dads / Good days" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
  ]
}
{% endschema %}
