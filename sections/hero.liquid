<section class="hero band">
  <div class="wrap">
    <div class="hero-top">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h1>{{ section.settings.heading | escape }}</h1>
        <div class="rule"></div>
      </div>
      <div>
        {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text | escape }}</p>{%- endif -%}
        <div class="ctas">
          {%- if section.settings.button_1 != blank -%}
            <a class="btn btn-ink" href="{{ section.settings.link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_1 | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_2 != blank -%}
            <a class="btn btn-line" href="{{ section.settings.link_2 | default: '#details' }}">{{ section.settings.button_2 | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
    <div class="hero-photo" style="--mobile-focus: {{ section.settings.mobile_focus }}%">
      {%- render 'section-image',
        image: section.settings.image,
        placeholder: section.settings.placeholder,
        alt: 'A French bulldog beside Frenchie Dad Club hats, tees, a hoodie and a tumbler',
        sizes: '(min-width: 1232px) 1200px, 100vw',
        eager: true
      -%}
    </div>
    {%- if section.settings.proof_1 != blank or section.settings.proof_2 != blank or section.settings.proof_3 != blank -%}
      <div class="proof">
        <div>{{ section.settings.proof_1 | escape }}</div>
        <div>{{ section.settings.proof_2 | escape }}</div>
        <div>{{ section.settings.proof_3 | escape }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dogs / Dads / Good days" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear for every kind of Frenchie dad." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hats, tees, hoodies and everyday gear, all with one clean logo. For the guys who lost half the couch to a snoring loaf with bat ears. Made to order and shipped in about a week." },
    { "type": "text", "id": "button_1", "label": "First button", "default": "Shop the club" },
    { "type": "url", "id": "link_1", "label": "First button link" },
    { "type": "text", "id": "button_2", "label": "Second button", "default": "See the details" },
    { "type": "url", "id": "link_2", "label": "Second button link", "info": "Leave empty to jump to the details section." },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Wide photo, about 2.5 to 1." },
    { "type": "text", "id": "placeholder", "label": "Placeholder file", "default": "hero-collection.jpg", "info": "Theme file shown until you pick an image. Leave as is." },
    { "type": "range", "id": "mobile_focus", "label": "Phone crop focus", "min": 0, "max": 100, "step": 2, "unit": "%", "default": 18, "info": "Which part of the photo stays in view on phones. 0 is the left edge." },
    { "type": "header", "content": "Proof row" },
    { "type": "text", "id": "proof_1", "label": "Item 1", "default": "Embroidered hats" },
    { "type": "text", "id": "proof_2", "label": "Item 2", "default": "Made to order" },
    { "type": "text", "id": "proof_3", "label": "Item 3", "default": "30-day exchanges" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
