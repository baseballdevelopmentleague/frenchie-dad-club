{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}
<section class="block band" id="shop">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="rule"></div>
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- render 'product-grid',
      products: source.products,
      types: section.settings.types,
      show_filters: section.settings.show_filters
    -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the club" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "One logo on hats, tees, hoodies, drinkware and the small stuff. Pick what fits how you spend your Saturdays." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show every product (up to 50)." },
    { "type": "checkbox", "id": "show_filters", "label": "Show category buttons", "default": true },
    { "type": "text", "id": "types", "label": "Categories (product types, in order)", "default": "Hats, Tees, Hoodies, Drinkware, Stickers, Extras", "info": "Must match each product's Type field exactly." }
  ],
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}
