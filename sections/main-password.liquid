{%- comment -%} Pre-launch page shown while the store is password protected. Collects launch signups. {%- endcomment -%}
<section class="soon-page band">
  <div class="wrap">
    <img class="soon-logo" src="{{ 'mark.png' | asset_url }}" alt="" width="360" height="336">
    <img class="soon-wm" src="{{ 'wordmark-plain-black.png' | asset_url }}" alt="{{ shop.name | escape }}" width="640" height="150">
    <div class="rule"></div>
    <p class="eyebrow" style="margin-top: 28px">{{ section.settings.eyebrow | escape }}</p>
    <p class="soon-text">{{ section.settings.text | escape }}</p>
    {%- form 'customer', class: 'soon-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      <label class="visually-hidden" for="soon-email">Email</label>
      <input id="soon-email" type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
      <button class="btn btn-ink" type="submit">Notify me</button>
      <div class="msg" role="status">
        {%- if form.posted_successfully? -%}You're on the list.{%- elsif form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
      </div>
    {%- endform -%}
    <details class="soon-owner">
      <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
      {%- form 'storefront_password' -%}
        <label class="visually-hidden" for="pw">{{ 'general.password_page.login_form_password_label' | t }}</label>
        <input id="pw" type="password" name="password" autocomplete="current-password">
        <button class="btn btn-line" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- if form.errors -%}<div class="msg">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dogs / Dads / Good days" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hats, tees and everyday gear for Frenchie dads. Opening soon. Leave your email and we'll tell you the day we launch." }
  ]
}
{% endschema %}
