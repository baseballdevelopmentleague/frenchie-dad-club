<section class="details block band" id="details">
  <div class="wrap">
    <div class="sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="rule"></div>
      </div>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        <figure class="tile" {{ block.shopify_attributes }}>
          <div class="ph">
            {%- render 'section-image',
              image: block.settings.image,
              placeholder: block.settings.placeholder,
              alt: block.settings.title,
              sizes: '(min-width: 760px) 33vw, 100vw'
            -%}
          </div>
          <figcaption><b>{{ block.settings.title | escape }}</b><span>{{ block.settings.text | escape }}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Details",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made like the logo matters" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Thick embroidery on the hats, a printed label inside every tee, and a small Frenchie tag on the back of each cap." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square photo." },
        { "type": "text", "id": "placeholder", "label": "Placeholder file", "info": "Theme file shown until you pick an image." },
        { "type": "text", "id": "title", "label": "Title", "default": "Detail" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Details",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
