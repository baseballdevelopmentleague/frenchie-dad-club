<section class="block band">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow">Search</div>
        <h1 class="h2">{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search the club{% endif %}</h1>
        <div class="rule"></div>
      </div>
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="q">Search</label>
        <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Hats, tees, mugs…">
        <button class="btn btn-ink" type="submit">Search</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- paginate search.results by 48 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{%- render 'product-card', product: item -%}{%- endif -%}
          {%- else -%}
            <p class="empty">Nothing matched. Try “hat” or “tee”.</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pager" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
