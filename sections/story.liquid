<section class="story block band" id="story">
  <div class="wrap">
    <div class="ph">
      {%- render 'section-image',
        image: section.settings.image,
        placeholder: section.settings.placeholder,
        alt: 'A Frenchie dad in a Frenchie Dad Club hat with his French bulldog',
        sizes: '(min-width: 860px) 45vw, 100vw'
      -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rule"></div>
      <div class="rte">{{ section.settings.body }}</div>
      {%- if section.settings.signature != blank -%}<div class="sig">{{ section.settings.signature | escape }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait photo, about 4 by 5." },
    { "type": "text", "id": "placeholder", "label": "Placeholder file", "default": "life-dad-dog.jpg", "info": "Theme file shown until you pick an image. Leave as is." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About the club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Started by a Frenchie dad who couldn't find a hat he'd actually wear." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story",
      "default": "<p>Frenchie Dad Club started on a couch in [your city], next to a [coat] Frenchie named [name] who snores louder than the TV. Most dog merch looked like it was made for a gift shop, so we made what we wanted to wear: clean hats and tees with a logo you'd be proud of.</p><p>Everything is made when you order it, so nothing sits in a warehouse. If it doesn't fit, we'll swap it.</p>"
    },
    { "type": "text", "id": "signature", "label": "Sign-off", "default": "See you at the dog park." }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
