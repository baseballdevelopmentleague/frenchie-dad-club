<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#FEFDF9">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'mark.png' | asset_url }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <style>
    {{ settings.type_body | font_face: font_display: 'swap' }}
    {{ settings.type_body | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
    {{ settings.type_body | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
    :root { --f-sans: {{ settings.type_body.family }}, "Helvetica Neue", Arial, {{ settings.type_body.fallback_families }}; }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <script>
    window.FDC = {
      markLines: {{ 'mark-lines.png' | asset_url | json }},
      moneyFormat: {{ shop.money_format | json }},
      routes: {
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip" href="#main">Skip to content</a>
  {% sections 'header-group' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <div class="toast" id="toast" role="status" hidden></div>
</body>
</html>
