<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="icon" type="image/png" href="{{ 'mark.png' | asset_url }}">
  <title>{{ shop.name }}</title>
  {%- if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif %}
  {% render 'meta-tags' %}
  <style>
    {{ settings.type_body | font_face: font_display: 'swap' }}
    {{ settings.type_body | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
    :root { --f-sans: {{ settings.type_body.family }}, "Helvetica Neue", Arial, {{ settings.type_body.fallback_families }}; }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
